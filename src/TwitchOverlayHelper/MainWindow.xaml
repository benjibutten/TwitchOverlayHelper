<Window x:Class="TwitchOverlayHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Overlay Helper" Width="1160" Height="800" MinWidth="980" MinHeight="640"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen"
        FontSize="14">
    <Window.Resources>
        <!-- The settings used to be one endless scroll of two columns; a rail turns it into six short
             pages you can point at instead of hunt through. TabControl keeps every control alive in
             the name scope even while its page is hidden, so the code-behind never has to know. -->
        <Style x:Key="NavRail" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="216" Background="#111521"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" Margin="12,16" />
                                </ScrollViewer>
                            </Border>
                            <!-- The name matters: TabItemAutomationPeer looks up PART_SelectedContentHost to
                                 hand the open page's controls to screen readers. Rename it and the whole
                                 settings surface disappears from the accessibility tree. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tag carries the glyph: an icon column makes the rail scannable without reading it. -->
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="11,10" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="14" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}" TextBlock.FontSize="14" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2030" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A1F49" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every page is the same frame: scroll region, generous gutter, two columns inside.
             BasedOn is load-bearing: a keyed style replaces the implicit one outright rather than
             adding to it, so without this the pages would fall back to the stock scroll template. -->
        <Style x:Key="Page" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="26,22,20,26" />
        </Style>
        <Style x:Key="Column" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StackedCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <!-- A field holding a number rather than a sentence. Narrower padding than the ordinary
             input, because what it holds is three or four characters and the padding was eating
             most of the box: at the settings window's smallest size the value being typed was
             scrolled out of sight by the caret. Centred for the same reason a price is – there is
             nothing to line up with on either side. -->
        <Style x:Key="NumberField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HintTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- The connection state used to live inside the first card, which meant it vanished the
             moment you scrolled past it. Up here it is true on every page. -->
        <Border Grid.Row="0" Background="#111521" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="26,15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TWITCH OVERLAY HELPER" Foreground="{StaticResource AccentTextBrush}" FontWeight="Bold" FontSize="12" />
                    <TextBlock Text="Läs chatten utan att lämna spelet" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="20" Padding="14,9" VerticalAlignment="Center">
                    <DockPanel>
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6B7280" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Inte ansluten" Foreground="#C8C5D3" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource NavRail}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource NavItem}" />
            </TabControl.Resources>

            <!-- ============================== Anslut ============================== -->
            <TabItem Header="Anslut" Tag="🔗">
                <ScrollViewer Style="{StaticResource Page}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <StackPanel Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Anslut chatten" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Kanalnamn eller Twitch-länk" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                    <TextBox x:Name="ChannelBox" ToolTip="Exempel: twitch eller https://twitch.tv/twitch" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button x:Name="ConnectButton" Content="Anslut" Click="ConnectButton_Click" />
                                        <Button x:Name="DisconnectButton" Grid.Column="2" Content="Koppla från" Background="#343B50" Click="DisconnectButton_Click" IsEnabled="False" />
                                    </Grid>
                                    <TextBlock Text="Anslutningens läge visas alltid uppe till höger, oavsett vilken sida du står på."
                                               Style="{StaticResource Hint}" Margin="0,12,0,0" />
                                    <CheckBox x:Name="RecentMessagesCheck" Content="Hämta chatt från innan appen startade" Margin="0,14,0,0"
                                              Checked="RecentMessages_Changed" Unchecked="RecentMessages_Changed"
                                              ToolTip="Fyller chatten med det som sagts den senaste stunden, så en omstart mitt i sändningen inte börjar från tomt." />
                                    <TextBlock Text="Twitch kan inte lämna ut gammal chatt, så raderna hämtas från recent-messages.robotty.de – samma tjänst som Chatterino använder. Kanalnamnet skickas dit vid varje anslutning. Stäng av om du hellre vill det."
                                               Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StackedCard}" Background="#171F2B" BorderBrush="#293649">
                                <StackPanel>
                                    <TextBlock Text="Dyslexivänlig grundprofil" Foreground="#78E1D5" FontWeight="SemiBold" />
                                    <TextBlock Text="Verdana, 22 px och generöst radavstånd minskar visuell trängsel. Varje chattare får en egen tydligt avskild yta."
                                               TextWrapping="Wrap" Foreground="#B8C2CF" Margin="0,6,0,0" LineHeight="20" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Logga in för moderering" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Krävs för timeout, ban, raid och för att kunna skriva i chatten från docken. Chatten går att läsa utan inloggning."
                                               Style="{StaticResource Lead}" Margin="0,7,0,12" />
                                    <Border Style="{StaticResource Sunken}" Padding="13" Margin="0,0,0,13">
                                        <StackPanel>
                                            <TextBlock Text="Så skapar du ett Client ID" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock TextWrapping="Wrap" Foreground="#CBC7D8" FontSize="14" LineHeight="22" Margin="0,7,0,0">
                                                1. Öppna dev.twitch.tv/console/apps och välj Registrera din applikation.<LineBreak />
                                                2. Namn: valfritt. OAuth Redirect URL: http://localhost<LineBreak />
                                                3. Kategori: Chat Bot. <Run FontWeight="Bold">Klienttyp måste vara Public.</Run><LineBreak />
                                                4. Kopiera appens Client ID hit nedan.
                                            </TextBlock>
                                            <Button x:Name="OpenDevConsoleButton" Content="Öppna dev.twitch.tv" Background="#343B50" Padding="12,7" HorizontalAlignment="Left" Margin="0,11,0,0" Click="OpenDevConsole_Click" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ClientIdBox" TextChanged="ClientId_TextChanged" />
                                    <Button x:Name="LoginButton" Content="Logga in med Twitch" Margin="0,12,0,0" Click="Login_Click" />
                                    <Border x:Name="DeviceCodeCard" Style="{StaticResource Sunken}" BorderBrush="#5A3FA0" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="DeviceCodeHint" Text="Gå till twitch.tv/activate och skriv in koden:" TextWrapping="Wrap" Foreground="#C8C5D3" />
                                            <TextBlock x:Name="DeviceCodeText" Text="" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="LoginStatusText" Text="Inte inloggad." Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                    <TextBlock x:Name="EventStatusText" Text="" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                    <Button x:Name="ReauthorizeButton" Content="Logga in igen för att slå på detta" Background="#343B50" Margin="0,8,0,0"
                                            Visibility="Collapsed" Click="Reauthorize_Click"
                                            ToolTip="En förnyad inloggning ger tillbaka de behörigheter du redan gett – nya måste godkännas på nytt" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Overlay ============================== -->
            <TabItem Header="Overlay" Tag="🖥">
                <ScrollViewer Style="{StaticResource Page}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <StackPanel Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Placera overlayen" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Lås upp för att dra i den lila raden och ändra storlek i hörnet." Style="{StaticResource Lead}" Margin="0,7,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button x:Name="EditButton" Content="Redigera overlay" Click="EditButton_Click" />
                                        <Button x:Name="VisibilityButton" Grid.Column="2" Content="Dölj overlay" Background="#343B50" Click="VisibilityButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StackedCard}">
                                <StackPanel>
                                    <TextBlock Text="Läsbarhet" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Ändringar syns direkt i overlayen." Style="{StaticResource Lead}" Margin="0,6,0,18" />

                                    <DockPanel><TextBlock Text="Textstorlek" /><TextBlock x:Name="FontSizeValue" Text="22 px" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,15" ValueChanged="Setting_ValueChanged" />
                                    <DockPanel><TextBlock Text="Radavstånd" /><TextBlock x:Name="LineSpacingValue" Text="1,42×" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="LineSpacingSlider" Minimum="1.15" Maximum="1.8" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,15" ValueChanged="Setting_ValueChanged" />
                                    <DockPanel><TextBlock Text="Rutans bakgrund" /><TextBlock x:Name="OpacityValue" Text="72 %" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,15" ValueChanged="Setting_ValueChanged" ToolTip="0 % tar bort rutans bakgrund helt" />
                                    <DockPanel><TextBlock Text="Meddelandebakgrund" /><TextBlock x:Name="MessageOpacityValue" Text="19 %" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="MessageOpacitySlider" Minimum="0" Maximum="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,17" ValueChanged="Setting_ValueChanged" ToolTip="0 % tar bort bakgrunden bakom varje meddelande" />

                                    <TextBlock Text="Typsnitt" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <ComboBox x:Name="FontFamilyBox" SelectionChanged="Setting_ValueChanged">
                                        <ComboBoxItem Content="Verdana" /><ComboBoxItem Content="Segoe UI" /><ComboBoxItem Content="Arial" /><ComboBoxItem Content="Comic Sans MS" />
                                    </ComboBox>

                                    <Border Style="{StaticResource Rule}" />

                                    <CheckBox x:Name="BadgesCheck" Content="Visa badges och rollikoner" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="NameColorsCheck" Content="Använd Twitch-namnfärger" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="TimestampCheck" Content="Visa klockslag" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="MentionsCheck" Content="Markera meddelanden till mig" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EmotesCheck" Content="Visa emotes som bilder" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="GiantEmotesCheck" Content="Visa förstorade emotes i full storlek" ToolTip="Power-upen “Gigantify an Emote” gör en emote tre gånger så stor. Av: emoten visas i vanlig storlek med en markör i stället." Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="OutlineCheck" Content="Kantlinje runt texten" ToolTip="Gör texten läsbar även utan bakgrund" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Händelser i overlayen" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Subs, raids och annat får ett eget kort bland meddelandena. Overlayen ligger ovanpå ett spel, så här är det ofta värt att välja ut några få. Avstängt tar bort korten som står kvar och gäller allt som händer sedan; docken har egna reglage under Ändra chattens läsbarhet."
                                               Style="{StaticResource Lead}" Margin="0,7,0,14" />
                                    <CheckBox x:Name="EventSubsCheck" Content="Prenumerationer och gåvor" ToolTip="Nya subs, resubs, gift subs och gåvor som fortsätter som betald sub" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventRaidsCheck" Content="Raids" ToolTip="Raids in i kanalen och raids härifrån" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventAnnouncementsCheck" Content="Meddelanden från streamern" ToolTip="/announce – färgade meddelanden från streamern eller en moderator" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventBitsCheck" Content="Bits-märken och firanden" ToolTip="Nytt bits-märke och power-upen Celebration. Vanliga cheers är markörer på meddelandet och påverkas inte." Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventMilestonesCheck" Content="Tittarstreaks och nya chattare" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventRewardsCheck" Content="Inlösta belöningar utan text" ToolTip="Belöningar med textfält syns som meddelandet de skapade och påverkas inte. Pets triggar oavsett." Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventShoutoutsCheck" Content="Shoutouts" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventHypeCheck" Content="Hypetåg" ToolTip="Två kort: ett när tåget startar och ett när det tar slut. Mätaren däremellan finns bara i docken." Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                    <CheckBox x:Name="EventOtherCheck" Content="Övriga händelser" ToolTip="Sådant Twitch skickar som vi inte har ett eget kort för – visas med Twitchs egen text" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StackedCard}">
                                <StackPanel>
                                    <TextBlock Text="Max antal meddelanden" Style="{StaticResource SubTitle}" />
                                    <TextBox x:Name="MaxMessagesInput" Margin="0,10,0,0" TextChanged="MaxMessages_TextChanged" LostKeyboardFocus="MaxMessages_LostKeyboardFocus" ToolTip="Ange ett tal mellan 1 och 200" />
                                    <TextBlock Text="De senaste meddelandena behålls i overlayen. När gränsen nås tas det äldsta bort. Hur många som ryms samtidigt beror också på overlayens höjd och textstorlek. (1–200)"
                                               Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Kantljus ============================== -->
            <TabItem Header="Kantljus" Tag="💡">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Ett mjukt ljus tonar in längs skärmens kanter och tonar ut igen – helt klickigenom, precis som overlayen. Mods kan kalla på din uppmärksamhet med ett kommando, och nya chattare kan hälsas med en egen färg så att du ser dem direkt."
                                   Style="{StaticResource Lead}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="När mods kallar på dig" Style="{StaticResource CardTitle}" />
                                    <CheckBox x:Name="EdgeModEnabledCheck" Content="Slå på mod-ljuset" Margin="0,12,0,0"
                                              ToolTip="Bara streamern och moderatorer kan trigga ljuset – kommandot gör ingenting när någon annan skriver det"
                                              Checked="EdgeSetting_Changed" Unchecked="EdgeSetting_Changed" />
                                    <TextBlock Text="Kommando" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <TextBox x:Name="EdgeModCommandBox" TextChanged="EdgeModCommand_TextChanged" LostKeyboardFocus="EdgeModCommand_LostKeyboardFocus"
                                             ToolTip="Ett ord som börjar med ! – text efteråt går bra, t.ex. “!psst kolla chatten”" />
                                    <TextBlock Text="Färg" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <ComboBox x:Name="EdgeModColorBox" SelectionChanged="EdgeSetting_Changed" />
                                    <DockPanel Margin="0,14,0,0"><TextBlock Text="Styrka" /><TextBlock x:Name="EdgeModIntensityValue" Text="70 %" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="EdgeModIntensitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="EdgeSetting_Changed" />
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="Varaktighet" /><TextBlock x:Name="EdgeModDurationValue" Text="6 s" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="EdgeModDurationSlider" Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="EdgeSetting_Changed" />
                                    <Button x:Name="EdgeModTestButton" Content="Testa mod-ljuset" Background="#343B50" Margin="0,14,0,0" Click="EdgeModTest_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="När en ny chattare skriver" Style="{StaticResource CardTitle}" />
                                    <CheckBox x:Name="EdgeNewEnabledCheck" Content="Slå på ny chattare-ljuset" Margin="0,12,0,0"
                                              ToolTip="Samma ögonblick som meddelandet med NY-markören – någon skriver i kanalen för första gången"
                                              Checked="EdgeSetting_Changed" Unchecked="EdgeSetting_Changed" />
                                    <TextBlock Text="Färg" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <ComboBox x:Name="EdgeNewColorBox" SelectionChanged="EdgeSetting_Changed" />
                                    <DockPanel Margin="0,14,0,0"><TextBlock Text="Styrka" /><TextBlock x:Name="EdgeNewIntensityValue" Text="70 %" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="EdgeNewIntensitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="EdgeSetting_Changed" />
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="Varaktighet" /><TextBlock x:Name="EdgeNewDurationValue" Text="6 s" Style="{StaticResource ValueBadge}" /></DockPanel>
                                    <Slider x:Name="EdgeNewDurationSlider" Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="EdgeSetting_Changed" />
                                    <Button x:Name="EdgeNewTestButton" Content="Testa ny chattare-ljuset" Background="#343B50" Margin="0,14,0,0" Click="EdgeNewTest_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StackedCard}">
                            <StackPanel>
                                <TextBlock Text="När en uppläsning väntar på svar" Style="{StaticResource SubTitle}" />
                                <TextBlock Text="Tänds när någon har betalat för att få ett meddelande uppläst och det ligger och väntar på ditt godkännande. Slås på under Uppläsning."
                                           Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Färg" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="EdgeTtsColorBox" SelectionChanged="EdgeSetting_Changed" />
                                        <Button x:Name="EdgeTtsTestButton" Content="Testa uppläsningsljuset" Background="#343B50" Margin="0,14,0,0" Click="EdgeTtsTest_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel><TextBlock Text="Styrka" /><TextBlock x:Name="EdgeTtsIntensityValue" Text="70 %" Style="{StaticResource ValueBadge}" /></DockPanel>
                                        <Slider x:Name="EdgeTtsIntensitySlider" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="EdgeSetting_Changed" />
                                        <DockPanel Margin="0,10,0,0"><TextBlock Text="Varaktighet" /><TextBlock x:Name="EdgeTtsDurationValue" Text="6 s" Style="{StaticResource ValueBadge}" /></DockPanel>
                                        <Slider x:Name="EdgeTtsDurationSlider" Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="EdgeSetting_Changed" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StackedCard}">
                            <StackPanel>
                                <TextBlock Text="Gäller alla färgerna" Style="{StaticResource SubTitle}" />
                                <DockPanel Margin="0,12,0,0"><TextBlock Text="Ljusets bredd" /><TextBlock x:Name="EdgeWidthValue" Text="160 px" Style="{StaticResource ValueBadge}" /></DockPanel>
                                <Slider x:Name="EdgeWidthSlider" Minimum="60" Maximum="320" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="EdgeSetting_Changed"
                                        ToolTip="Hur långt in från kanten ljuset når – gäller alla färgerna" />
                                <TextBlock Text="Ljuset visas på huvudskärmen och går aldrig att klicka på. Testa-knapparna visar exakt hur det kommer se ut."
                                           Style="{StaticResource Hint}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== OBS-dock ============================== -->
            <TabItem Header="OBS-dock" Tag="🌐">
                <ScrollViewer Style="{StaticResource Page}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <StackPanel Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Chatt i OBS" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Lägg till adressen som en Custom Browser Dock i OBS (Vy → Dockor → Anpassade webbläsardockor)."
                                               Style="{StaticResource Lead}" Margin="0,7,0,12" />
                                    <Border Style="{StaticResource Sunken}" Padding="11,9">
                                        <TextBox x:Name="DockUrlBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource AccentTextBrush}" FontFamily="Consolas" Padding="0" />
                                    </Border>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button x:Name="CopyDockUrlButton" Content="Kopiera adress" Click="CopyDockUrl_Click" />
                                        <Button x:Name="OpenDockButton" Grid.Column="2" Content="Förhandsgranska" Background="#343B50" Click="OpenDock_Click" />
                                    </Grid>
                                    <Button x:Name="DockAppearanceButton" Content="Ändra chattens läsbarhet" Background="#343B50" Margin="0,10,0,0" Click="DockAppearance_Click" />
                                    <Border Style="{StaticResource Sunken}" BorderThickness="0" Margin="0,12,0,0">
                                        <DockPanel>
                                            <Ellipse x:Name="DockStatusDot" Width="9" Height="9" Fill="#6B7280" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DockStatusText" Text="Servern startar …" Foreground="#C8C5D3" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="Adressen innehåller en hemlig nyckel och fungerar bara från den här datorn. Dela den inte."
                                               Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Chatt på streamen" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Samma chatt, fast för tittarna. Lägg till adressen som en Browser Source i OBS – genomskinlig bakgrund, inga knappar. Smeknamn, moderering, inloggning och fastnålat stannar i docken och når aldrig sändningen."
                                               Style="{StaticResource Lead}" Margin="0,7,0,12" />
                                    <Border Style="{StaticResource Sunken}" Padding="11,9">
                                        <TextBox x:Name="StreamUrlBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource AccentTextBrush}" FontFamily="Consolas" Padding="0" />
                                    </Border>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button x:Name="CopyStreamUrlButton" Content="Kopiera adress" IsEnabled="False" Click="CopyStreamUrl_Click" />
                                        <Button x:Name="OpenStreamButton" Grid.Column="2" Content="Förhandsgranska" Background="#343B50" IsEnabled="False" Click="OpenStream_Click" />
                                    </Grid>
                                    <Button x:Name="StreamAppearanceButton" Content="Ändra utseende på streamchatten" Background="#343B50" Margin="0,10,0,0" Click="StreamAppearance_Click" />
                                    <TextBlock Text="Tips: gör källan ungefär 460 × 800 px i OBS och dra den dit du vill ha chatten. Rutan växer från underkanten."
                                               Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StackedCard}">
                                <StackPanel>
                                    <TextBlock Text="Uppläsning av namn" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Valfritt" Foreground="{StaticResource HintTextBrush}" FontSize="13" Margin="0,3,0,0" />
                                    <TextBlock Text="Lägger en högtalarknapp bredvid varje namn i OBS-docken. Ett klick läser upp hur namnet troligen sägs, här på datorn. Kräver en API-nyckel till DeepSeek och en till ElevenLabs – utan dem syns ingen knapp."
                                               Style="{StaticResource Lead}" Margin="0,9,0,12" />
                                    <Button x:Name="SpeechSettingsButton" Content="Ställ in uppläsning" Background="#343B50" Click="SpeechSettings_Click" />
                                    <Border Style="{StaticResource Sunken}" BorderThickness="0" Margin="0,12,0,0">
                                        <TextBlock x:Name="SpeechStatusText" Text="Inte konfigurerat – ingen knapp visas i docken." Foreground="#C8C5D3" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Pets ============================== -->
            <TabItem Header="Pets" Tag="🐾">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Små figurer som går omkring längst ned i bild. När en tittare löser in en channel points-belöning skriver de namnet på den pet de vill ha – blaze, uggla, spöke… – och just den dyker upp, busar och interagerar med de andra. Lägg till adressen som en Browser Source i OBS, över spelet."
                                   Style="{StaticResource Lead}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource Column}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Adress till OBS" Style="{StaticResource SubTitle}" />
                                        <Border Style="{StaticResource Sunken}" Padding="11,9" Margin="0,10,0,0">
                                            <TextBox x:Name="PetsUrlBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource AccentTextBrush}" FontFamily="Consolas" Padding="0" />
                                        </Border>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="CopyPetsUrlButton" Content="Kopiera adress" IsEnabled="False" Click="CopyPetsUrl_Click" />
                                            <Button x:Name="OpenPetsButton" Grid.Column="2" Content="Förhandsgranska" Background="#343B50" IsEnabled="False" Click="OpenPets_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StackedCard}">
                                    <StackPanel>
                                        <TextBlock Text="Inställningar" Style="{StaticResource SubTitle}" />
                                        <CheckBox x:Name="PetsEnabledCheck" Content="Aktivera pets" Margin="0,12,0,0" Checked="PetSetting_Changed" Unchecked="PetSetting_Changed" />
                                        <CheckBox x:Name="PetNamesCheck" Content="Visa namnskylt under varje pet" Checked="PetSetting_Changed" Unchecked="PetSetting_Changed"
                                                  ToolTip="Skylten visar namnet på tittaren som löste in peten. Stäng av för en renare overlay." />

                                        <DockPanel Margin="0,14,0,0"><TextBlock Text="Storlek" /><TextBlock x:Name="PetScaleValue" Text="100 %" Style="{StaticResource ValueBadge}" /></DockPanel>
                                        <Slider x:Name="PetScaleSlider" Minimum="0.4" Maximum="2.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="PetSetting_Changed"
                                                ToolTip="Hur stora robotarna är i overlayen – ändringen syns direkt" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Standardtid (minuter)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="PetLifetimeInput" TextChanged="PetLifetime_TextChanged" LostKeyboardFocus="PetLifetime_LostKeyboardFocus"
                                                         ToolTip="1–60 minuter. Används för !pet och för belöningar utan egen tid i listan nedan." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Max antal samtidigt" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="PetMaxInput" TextChanged="PetMax_TextChanged" LostKeyboardFocus="PetMax_LostKeyboardFocus" ToolTip="1–20. När det är fullt får den äldsta roboten gå hem." />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Standardpet" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                        <ComboBox x:Name="PetDefaultBox" SelectionChanged="PetDefault_Changed"
                                                  ToolTip="Vilken pet som ges när tittarens text inte matchar något namn" />

                                        <Button x:Name="SpawnTestPetButton" Content="🐣 Spawna testpet" Margin="0,14,0,0" Click="SpawnTestPet_Click"
                                                ToolTip="Varje klick visar nästa pet i listan" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource Column}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Tillgängliga pets" Style="{StaticResource SubTitle}" />
                                        <TextBlock x:Name="PetListText" Text="" Style="{StaticResource Hint}" Margin="0,8,0,0" LineHeight="19" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="OpenPetsFolderButton" Content="Öppna pets-mappen" Background="#343B50" Click="OpenPetsFolder_Click"
                                                    ToolTip="Alla pets ligger här: en mapp per pet med pet.json och body.svg" />
                                            <Button x:Name="ReloadPetsButton" Grid.Column="2" Content="Ladda om pets" Background="#343B50" Click="ReloadPets_Click"
                                                    ToolTip="Läser in pets-mappen igen utan att starta om appen" />
                                        </Grid>
                                        <TextBlock Text="Alla pets ligger i pets-mappen, även de som följer med appen – en mapp per pet med pet.json och body.svg. Ändra färg, namn eller rita en helt egen och klicka Ladda om pets. En pet du kläckt med Codex hatch-pet kopieras hit rakt av: har mappen en spritesheet.webp (9 rader × 8 rutor à 192×208) används den i stället."
                                                   Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Hela sidans bredd, inte en av kolumnerna: raden är en tabell med sex fält,
                             och ett Twitch-ID är 36 tecken. I en halv kolumn blev varje ruta så smal
                             att siffran man skrev in låg utanför den synliga delen av fältet. -->
                        <Border Style="{StaticResource StackedCard}">
                            <StackPanel>
                                <TextBlock Text="Belöningar som ger pets" Style="{StaticResource SubTitle}" />
                                <Grid x:Name="PetRewardHeader" Margin="0,14,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="78" /><ColumnDefinition Width="8" /><ColumnDefinition Width="96" /><ColumnDefinition Width="8" /><ColumnDefinition Width="40" /><ColumnDefinition Width="6" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2" Text="Namn" Style="{StaticResource TableHeading}" />
                                    <TextBlock Grid.Column="4" Text="Belönings-ID" Style="{StaticResource TableHeading}" />
                                    <TextBlock Grid.Column="6" Text="Minuter" Style="{StaticResource TableHeading}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="8" Text="Poäng" Style="{StaticResource TableHeading}" HorizontalAlignment="Center" />
                                </Grid>
                                <ItemsControl x:Name="PetRewardList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="78" /><ColumnDefinition Width="8" /><ColumnDefinition Width="96" /><ColumnDefinition Width="8" /><ColumnDefinition Width="40" /><ColumnDefinition Width="6" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusGlyph}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"
                                                           ToolTip="🔒 = skapad av appen och kan återbetalas. — = skapad för hand i Twitch, poängen kan inte lämnas tillbaka." />
                                                <TextBox Grid.Column="2" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" TextChanged="PetReward_Changed"
                                                         ToolTip="Namnet belöningen får i Twitch när du skapar den härifrån. Används annars bara som din egen anteckning." />
                                                <!-- Låst när appen skapat belöningen: ID:t är det enda som binder raden till den belöning
                                                     Twitch låter oss svara på, och ett ändrat ID skulle lämna 🔒 kvar på en rad som inte
                                                     längre kan återbetala. Peka om en rad genom att ta bort den och skapa en ny. -->
                                                <TextBox Grid.Column="4" Text="{Binding RewardId, UpdateSourceTrigger=PropertyChanged}" TextChanged="PetReward_Changed"
                                                         FontFamily="Consolas" FontSize="13" Padding="9,10"
                                                         IsReadOnly="{Binding Managed}"
                                                         ToolTip="Belöningens ID från Twitch. Lämna tomt så gäller raden alla övriga inlösen. Skapade appen belöningen är ID:t låst – ta bort raden och gör en ny för att peka om den." />
                                                <TextBox Grid.Column="6" Style="{StaticResource NumberField}" Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" TextChanged="PetReward_Changed"
                                                         LostKeyboardFocus="PetRewardMinutes_LostKeyboardFocus" ToolTip="1–60 minuter" />
                                                <TextBox Grid.Column="8" Style="{StaticResource NumberField}" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" TextChanged="PetReward_Changed"
                                                         LostKeyboardFocus="PetRewardCost_LostKeyboardFocus" ToolTip="Vad belöningen ska kosta i channel points när appen skapar den." />
                                                <Button Grid.Column="10" Content="⚡" Background="#343B50" Padding="0,8" Click="CreatePetReward_Click"
                                                        ToolTip="Skapa belöningen i Twitch från den här raden. Bara belöningar appen själv skapat kan återbetalas." />
                                                <Button Grid.Column="12" Content="✕" Background="#343B50" Padding="0,8" Click="RemovePetReward_Click"
                                                        ToolTip="Ta bort raden. Belöningen ligger kvar i Twitch." />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="PetRewardEmptyText" Text="Inga belöningar tillagda – varje channel points-inlösen med textfält ger en pet på standardtiden."
                                           Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button x:Name="AddPetRewardButton" Content="+ Lägg till belöning" Background="#343B50" Click="AddPetReward_Click" />
                                    <Button x:Name="UseLastRewardButton" Grid.Column="2" Content="Använd senaste inlösta" Background="#343B50" IsEnabled="False" Click="UseLastReward_Click"
                                            ToolTip="Lägger till en rad med ID:t från den senaste inlösen i chatten" />
                                </Grid>
                                <TextBlock x:Name="LastRewardText" Text="Ingen inlösen har synts i chatten ännu." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                <TextBlock x:Name="PetRewardStatusText" Text="" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="⚡ skapar belöningen i Twitch åt dig, med kön påslagen så att poängen kan lämnas tillbaka. En pet som aldrig ritades – overlayen nere, gräsmattan full – återbetalas automatiskt, och en som levde klart bokförs som klar. Belöningar du skapat för hand i Twitch fungerar precis som förut, men går aldrig att återbetala härifrån."
                                           Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                <TextBlock Text="Kräver att belöningen ber tittaren skriva något om arten ska kunna väljas. Du och dina moderatorer kan testa med !pet eller !pet namn, t.ex. !pet boo."
                                           Style="{StaticResource Hint}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Uppläsning ============================== -->
            <TabItem Header="Uppläsning" Tag="🗣">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Tittare betalar för att få ett meddelande uppläst i sändningen. Med bits blir det en Power-up, med channel points en vanlig belöning – välj själv. Du kan låta varje meddelande vänta på ditt godkännande: då dyker det upp som en rad högst upp i OBS-docken där du väljer att läsa upp eller neka, innan någon hör ett ord."
                                   Style="{StaticResource Lead}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource Column}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Vad tittaren betalar med" Style="{StaticResource SubTitle}" />
                                        <CheckBox x:Name="TtsEnabledCheck" Content="Aktivera uppläsning" Margin="0,12,0,0" Checked="TtsSetting_Changed" Unchecked="TtsSetting_Changed" />

                                        <RadioButton x:Name="TtsPowerUpRadio" GroupName="TtsTrigger" Content="Power-up (bits)" Margin="0,14,0,0"
                                                     Checked="TtsTrigger_Changed"
                                                     ToolTip="Custom Power-ups skapar du i Twitchs Creator Dashboard. Appen kan läsa dem men aldrig ändra dem." />
                                        <RadioButton x:Name="TtsRewardRadio" GroupName="TtsTrigger" Content="Belöning (channel points)" Margin="0,7,0,0"
                                                     Checked="TtsTrigger_Changed"
                                                     ToolTip="Skapas härifrån med kön påslagen, så att poängen kan lämnas tillbaka när du nekar." />

                                        <StackPanel x:Name="TtsPowerUpPanel" Margin="0,14,0,0">
                                            <TextBlock Text="Power-up" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                            <ComboBox x:Name="TtsPowerUpBox" DisplayMemberPath="Title" SelectionChanged="TtsPowerUp_SelectionChanged"
                                                      ToolTip="Hämta listan nedan och välj vilken Power-up som ska läsa upp meddelanden" />
                                            <TextBox x:Name="TtsPowerUpIdBox" Margin="0,7,0,0" FontFamily="Consolas" FontSize="13" Padding="9,10"
                                                     TextChanged="TtsSetting_Changed"
                                                     ToolTip="Power-upens ID. Lämna tomt så räknas varje custom Power-up i kanalen." />
                                            <Button x:Name="TtsFetchPowerUpsButton" Content="Hämta Power-ups från Twitch" Background="#343B50" Margin="0,10,0,0" Click="TtsFetchPowerUps_Click" />
                                            <TextBlock Text="Power-upen måste be tittaren skriva något, annars kommer det ingen text att läsa upp. Bits kan aldrig betalas tillbaka: Twitch har inget API för det, så “Neka” betyder att meddelandet inte läses upp – inte att bitsen kommer tillbaka."
                                                       Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                        </StackPanel>

                                        <StackPanel x:Name="TtsRewardPanel" Margin="0,14,0,0">
                                            <TextBlock Text="Belöningens namn" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                            <TextBox x:Name="TtsRewardTitleBox" TextChanged="TtsSetting_Changed"
                                                     ToolTip="Namnet belöningen får i Twitch när du skapar den härifrån" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Poäng" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="TtsRewardCostBox" Style="{StaticResource NumberField}" TextChanged="TtsSetting_Changed"
                                                             LostKeyboardFocus="TtsRewardCost_LostKeyboardFocus" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Belönings-ID" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="TtsRewardIdBox" FontFamily="Consolas" FontSize="13" Padding="9,10" TextChanged="TtsSetting_Changed"
                                                             ToolTip="Fylls i automatiskt när appen skapar belöningen. Klistrar du in ett ID till en belöning du gjort för hand går den att läsa upp men aldrig att återbetala." />
                                                </StackPanel>
                                            </Grid>
                                            <Button x:Name="TtsCreateRewardButton" Content="⚡ Skapa belöningen i Twitch" Background="#343B50" Margin="0,10,0,0" Click="TtsCreateReward_Click" />
                                            <TextBlock x:Name="TtsRewardHint" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StackedCard}">
                                    <StackPanel>
                                        <TextBlock Text="Godkännande" Style="{StaticResource SubTitle}" />
                                        <CheckBox x:Name="TtsApprovalCheck" Content="Fråga mig innan något läses upp" Margin="0,12,0,0" Checked="TtsSetting_Changed" Unchecked="TtsSetting_Changed"
                                                  ToolTip="Raden visas högst upp i OBS-docken med Godkänn och Neka. Stänger du av läses varje inlöst meddelande upp direkt." />
                                        <CheckBox x:Name="TtsEdgeAlertCheck" Content="Tänd kantljuset när något väntar på svar" Checked="TtsSetting_Changed" Unchecked="TtsSetting_Changed"
                                                  ToolTip="Samma mjuka ljus längs skärmkanterna som mod-kommandot använder, i egen färg. Ställs in under Kantljus." />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Svarstid (minuter)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="TtsTimeoutBox" Style="{StaticResource NumberField}" TextChanged="TtsSetting_Changed"
                                                         LostKeyboardFocus="TtsTimeout_LostKeyboardFocus"
                                                         ToolTip="Hinner du inte svara släpps inlösen – med channel points får tittaren tillbaka poängen." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Max i kö" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="TtsQueueBox" Style="{StaticResource NumberField}" TextChanged="TtsSetting_Changed"
                                                         LostKeyboardFocus="TtsQueue_LostKeyboardFocus"
                                                         ToolTip="Fler inlösen än så nekas direkt i stället för att ställas i en kö ingen hinner igenom." />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource Column}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Var ljudet hamnar" Style="{StaticResource SubTitle}" />
                                        <TextBlock Text="OBS tar in ljudet från en Browser Source av sig själv, med egen volym och egen ljudkanal. Appens eget ljud går ut på skrivbordet och hörs bara av tittarna om du fångar Desktop Audio – vilket de flesta med flit låter bli."
                                                   Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                        <RadioButton x:Name="TtsOutputBrowserRadio" GroupName="TtsOutput" Content="Browser Source i OBS (rekommenderas)" Margin="0,12,0,0"
                                                     Checked="TtsOutput_Changed" />
                                        <RadioButton x:Name="TtsOutputDesktopRadio" GroupName="TtsOutput" Content="Den här datorns högtalare" Margin="0,7,0,0"
                                                     Checked="TtsOutput_Changed"
                                                     ToolTip="Bara du hör det, om inte OBS fångar Desktop Audio" />
                                        <RadioButton x:Name="TtsOutputBothRadio" GroupName="TtsOutput" Content="Båda" Margin="0,7,0,0" Checked="TtsOutput_Changed" />

                                        <TextBlock Text="Adress till OBS" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                        <Border Style="{StaticResource Sunken}" Padding="11,9">
                                            <TextBox x:Name="TtsUrlBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource AccentTextBrush}" FontFamily="Consolas" Padding="0" />
                                        </Border>
                                        <Button x:Name="CopyTtsUrlButton" Content="Kopiera adress" Margin="0,10,0,0" IsEnabled="False" Click="CopyTtsUrl_Click" />
                                        <TextBlock Text="Lägg till som Browser Source i OBS, 1×1 px – den syns inte, den låter bara. Kryssa i “Control audio via OBS” om du vill ha den som en egen reglage i mixern."
                                                   Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StackedCard}">
                                    <StackPanel>
                                        <TextBlock Text="Rösten" Style="{StaticResource SubTitle}" />
                                        <TextBlock Text="Egen röst för uppläsningar – den behöver inte vara samma som läser upp namn. Samma ElevenLabs-nyckel används; den sparas under Uppläsning av namn."
                                                   Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                        <TextBlock Text="Röst" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                        <ComboBox x:Name="TtsVoiceBox" DisplayMemberPath="Name" SelectionChanged="TtsVoice_SelectionChanged" />
                                        <TextBox x:Name="TtsVoiceIdBox" Margin="0,7,0,0" FontFamily="Consolas" FontSize="13" Padding="9,10" TextChanged="TtsSetting_Changed"
                                                 ToolTip="Röstens ID i ElevenLabs. Fylls i när du väljer en röst i listan." />
                                        <Button x:Name="TtsFetchVoicesButton" Content="Hämta röster" Background="#343B50" Margin="0,10,0,0" Click="TtsFetchVoices_Click" />
                                        <TextBlock x:Name="TtsVoiceHint" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" />

                                        <TextBlock Text="Modell" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                        <TextBox x:Name="TtsModelBox" TextChanged="TtsSetting_Changed" ToolTip="t.ex. eleven_v3" />

                                        <DockPanel Margin="0,14,0,0"><TextBlock Text="Volym" /><TextBlock x:Name="TtsVolumeValue" Text="90 %" Style="{StaticResource ValueBadge}" /></DockPanel>
                                        <Slider x:Name="TtsVolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="TtsSetting_Changed" />

                                        <DockPanel Margin="0,10,0,0"><TextBlock Text="Max antal tecken" /><TextBlock x:Name="TtsMaxCharsValue" Text="240" Style="{StaticResource ValueBadge}" /></DockPanel>
                                        <Slider x:Name="TtsMaxCharsSlider" Minimum="20" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="TtsSetting_Changed"
                                                ToolTip="Längre meddelanden klipps vid närmaste ordslut. ElevenLabs tar betalt per tecken, så det här avgör vad en inlösen kan kosta dig." />

                                        <CheckBox x:Name="TtsAnnounceNameCheck" Content="Läs “Namn säger:” före meddelandet" Margin="0,14,0,0" Checked="TtsSetting_Changed" Unchecked="TtsSetting_Changed" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StackedCard}">
                                    <StackPanel>
                                        <TextBlock Text="Testa" Style="{StaticResource SubTitle}" />
                                        <TextBox x:Name="TtsTestBox" Margin="0,12,0,0" Text="Hej! Det här är ett testmeddelande från chatten." />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="TtsTestButton" Content="🔊 Läs upp" Click="TtsTest_Click" />
                                            <Button x:Name="TtsTestBannerButton" Grid.Column="2" Content="Testa rutan i docken" Background="#343B50" Click="TtsTestBanner_Click"
                                                    ToolTip="Lägger en påhittad inlösen i kön så du ser hur raden ser ut i OBS-docken" />
                                        </Grid>
                                        <TextBlock x:Name="TtsStatusText" Text="" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Bot ============================== -->
            <TabItem Header="Bot" Tag="🤖">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Appen vet redan varför en inlösen betalades tillbaka, att en uppläsning fortfarande väntar på ditt svar och att overlayen ligger nere – men hittills har den bara sagt det till dig. Boten säger det till den som faktiskt betalade. Använd gärna ett eget Twitch-konto: logga in med det här, gör det till moderator i din kanal, så syns dess meddelanden som kanalens och inte som dina."
                                   Style="{StaticResource Lead}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                            <StackPanel Style="{StaticResource Column}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Vem skriver" Style="{StaticResource CardTitle}" />
                                        <RadioButton x:Name="BotModeOffRadio" GroupName="BotMode" Content="Av – ingenting skrivs i chatten" Margin="0,14,0,0" Checked="BotMode_Changed" />
                                        <RadioButton x:Name="BotModeBotRadio" GroupName="BotMode" Content="Eget botkonto" Margin="0,7,0,0" Checked="BotMode_Changed"
                                                     ToolTip="Ett andra Twitch-konto med egen inloggning. Begär bara rätten att läsa och skriva i chatten – ingen moderering, inga belöningar." />
                                        <RadioButton x:Name="BotModeStreamerRadio" GroupName="BotMode" Content="Mitt eget konto" Margin="0,7,0,0" Checked="BotMode_Changed"
                                                     ToolTip="Använder anslutningen appen redan har. Fungerar direkt, men meddelandena ser ut att komma från dig." />

                                        <Border Style="{StaticResource Rule}" Margin="0,16,0,16" />

                                        <TextBlock Text="Botens Twitch-konto" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="Logga ut från Twitch i webbläsaren först, eller använd ett privat fönster – annars godkänns koden med ditt eget konto. Samma Client ID som under Anslutning används."
                                                   Style="{StaticResource Hint}" Margin="0,6,0,10" TextWrapping="Wrap" />
                                        <Button x:Name="BotLoginButton" Content="Logga in som bot" Click="BotLogin_Click" />

                                        <Border x:Name="BotDeviceCard" Style="{StaticResource Sunken}" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="BotDeviceHint" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="BotDeviceText" FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                                                           Foreground="{StaticResource AccentTextBrush}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="BotStatusText" Text="Ingen bot inloggad." Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="BotLastLineText" Text="" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StackedCard}">
                                    <StackPanel>
                                        <TextBlock Text="Meddelanden" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Här skriver du egna kommandon – ett ord någon skriver i chatten och vad boten svarar. Samma ställe rymmer allt appen säger av sig själv: återbetalningar, väntande uppläsningar, välkomsthälsningar och raids, var och en att slå av eller skriva om."
                                                   Style="{StaticResource Lead}" Margin="0,7,0,14" />
                                        <Button x:Name="BotMessagesButton" Content="Ställ in vad boten säger" Background="#343B50" HorizontalAlignment="Left" Click="BotMessages_Click" />
                                        <TextBlock x:Name="BotMessageCountText" Text="" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource Column}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Ord boten använder" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Ingenting här är appens sak att döpa. Kallar din kanal dem något annat än pets så skriver du det – orden slår igenom i alla meddelanden, även i förklaringen till varför något betalades tillbaka."
                                                   Style="{StaticResource Lead}" Margin="0,7,0,14" />

                                        <TextBlock Text="Vad boten kallar dig" Style="{StaticResource FieldLabel}" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BotStreamerNameBox" TextChanged="BotSetting_Changed" />
                                            <Button x:Name="BotUseChannelNameButton" Grid.Column="2" Content="Kanalnamnet" Background="#343B50" Padding="13,8" Click="BotUseChannelName_Click" />
                                        </Grid>
                                        <TextBlock Text="Tomt betyder “streamern”." Style="{StaticResource Hint}" Margin="0,0,0,14" />

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="En" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="BotPetWordBox" TextChanged="BotSetting_Changed" ToolTip="Obestämd form, singular: en pet" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Flera" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="BotPetPluralBox" TextChanged="BotSetting_Changed" ToolTip="Plural: två pets" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Bestämd form" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="BotPetDefiniteBox" TextChanged="BotSetting_Changed" ToolTip="Bestämd form, singular: peten. Egen ruta för att svenskan inte går att räkna ut – vän blir vännen, pet blir peten." />
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StackedCard}">
                                    <StackPanel>
                                        <TextBlock Text="Takt och gränser" Style="{StaticResource CardTitle}" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Vänta på svar innan boten puffar (sekunder)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBox x:Name="BotWaitSecondsBox" Grid.Column="2" Style="{StaticResource NumberField}" TextChanged="BotSetting_Changed"
                                                     LostKeyboardFocus="BotNumber_LostKeyboardFocus" ToolTip="Hur länge en uppläsning får ligga obesvarad innan boten talar om för tittaren att den ligger kvar. 10–3600." />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Meddelanden per 30 sekunder" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBox x:Name="BotRateBox" Grid.Column="2" Style="{StaticResource NumberField}" TextChanged="BotSetting_Changed"
                                                     LostKeyboardFocus="BotNumber_LostKeyboardFocus" ToolTip="Twitchs eget tak är 20 för ett vanligt konto och 100 för en moderator. Straffet för att gå över är skrivstopp på hela kontot, inte ett tappat meddelande – så håll marginal." />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Slå ihop återbetalningar från och med" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBox x:Name="BotBatchBox" Grid.Column="2" Style="{StaticResource NumberField}" TextChanged="BotSetting_Changed"
                                                     LostKeyboardFocus="BotNumber_LostKeyboardFocus" ToolTip="Städningen efter en omstart kan svara på en hel sändnings inlösen på några sekunder. Så många eller fler blir en enda rad i stället för en rad var." />
                                        </Grid>

                                        <CheckBox x:Name="BotHideOwnCheck" Content="Dölj botens meddelanden i overlayen" Margin="0,16,0,0" Checked="BotSetting_Changed" Unchecked="BotSetting_Changed"
                                                  ToolTip="Överst på spelet är botens svar en ström av notiser. I docken syns de fortfarande." />
                                        <CheckBox x:Name="BotIgnoreOwnCheck" Content="Låt inte botens egna rader trigga något" Margin="0,8,0,0" Checked="BotSetting_Changed" Unchecked="BotSetting_Changed"
                                                  ToolTip="Utan den kan boten hälsa på sin egen hälsning eller spawna en pet ur sitt eget meddelande." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Program ============================== -->
            <TabItem Header="Program" Tag="⚙">
                <ScrollViewer Style="{StaticResource Page}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <StackPanel Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Snabbtangenter" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Fungerar globalt – även när spelet har fokus." Style="{StaticResource Lead}" Margin="0,7,0,14" />

                                    <TextBlock Text="Visa/dölj overlay" Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Sunken}" Padding="11,8">
                                            <TextBlock x:Name="ToggleHotkeyLabel" Text="Ctrl + F9" Foreground="{StaticResource AccentTextBrush}" FontWeight="Bold" />
                                        </Border>
                                        <Button x:Name="RecordToggleHotkeyButton" Grid.Column="2" Content="⌨ Ändra" Background="#343B50" Padding="13,8" Click="RecordToggleHotkey_Click" />
                                    </Grid>

                                    <TextBlock Text="Redigera overlay" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Sunken}" Padding="11,8">
                                            <TextBlock x:Name="EditHotkeyLabel" Text="Ctrl + F10" Foreground="{StaticResource AccentTextBrush}" FontWeight="Bold" />
                                        </Border>
                                        <Button x:Name="RecordEditHotkeyButton" Grid.Column="2" Content="⌨ Ändra" Background="#343B50" Padding="13,8" Click="RecordEditHotkey_Click" />
                                    </Grid>

                                    <TextBlock x:Name="HotkeyHint" Text="Välj Ändra och tryck sedan önskad tangentkombination. Esc avbryter." Style="{StaticResource Hint}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Style="{StaticResource Column}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Windows" Style="{StaticResource CardTitle}" />
                                    <CheckBox x:Name="StartWithWindowsCheck"
                                              Content="Starta med Windows"
                                              Margin="0,12,0,0"
                                              ToolTip="Startar minimerad i aktivitetsfältets meddelandefält när du loggar in"
                                              Checked="StartWithWindows_Changed"
                                              Unchecked="StartWithWindows_Changed" />
                                    <TextBlock Text="Appen startar i bakgrunden utan att öppna inställningsfönstret."
                                               Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#111521" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="26,12">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="#8B8799" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Sök efter uppdateringar" Click="CheckForUpdates_Click"
                        Background="#232A3B" Foreground="#C9C5D8" FontSize="13" FontWeight="Normal"
                        Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Tips: lås overlayen när den ligger rätt – då blir den helt klickigenom och stjäl aldrig fokus från spelet."
                           Foreground="#A8A3B8" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
