<Window x:Class="TwitchOverlayHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Overlay Helper" Width="1040" Height="760" MinWidth="900" MinHeight="650"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="TWITCH OVERLAY HELPER" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="13" />
            <TextBlock Text="Läs chatten utan att lämna spelet" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="En lugn, stor och dyslexivänlig chatt-overlay som du styr härifrån." Foreground="{StaticResource MutedTextBrush}" FontSize="15" Margin="0,7,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="1. Anslut chatten" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Kanalnamn eller Twitch-länk" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,6" />
                        <TextBox x:Name="ChannelBox" ToolTip="Exempel: twitch eller https://twitch.tv/twitch" />
                        <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="ConnectButton" Content="Anslut" Click="ConnectButton_Click" />
                            <Button x:Name="DisconnectButton" Grid.Column="2" Content="Koppla från" Background="#343B50" Click="DisconnectButton_Click" IsEnabled="False" />
                        </Grid>
                        <Border Background="#10141F" CornerRadius="8" Padding="11" Margin="0,12,0,0">
                            <DockPanel><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6B7280" Margin="0,0,9,0" /><TextBlock x:Name="StatusText" Text="Inte ansluten" Foreground="#C8C5D3" /></DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="2. Placera overlayen" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Lås upp för att dra i den lila raden och ändra storlek i hörnet." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,14" />
                        <Button x:Name="EditButton" Content="Redigera overlay" Click="EditButton_Click" />
                        <Button x:Name="VisibilityButton" Content="Dölj overlay" Background="#343B50" Margin="0,10,0,0" Click="VisibilityButton_Click" />
                    </StackPanel>
                </Border>

                <Expander Header="Twitch-inloggning och riktiga badges (valfritt)" Foreground="{StaticResource TextBrush}" Margin="0,18,0,0" Expanded="AuthExpander_Expanded">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Client ID" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="ClientIdBox" Margin="0,5,0,10" />
                            <TextBlock Text="Twitch-användarnamn" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="UserNameBox" Margin="0,5,0,10" />
                            <TextBlock Text="OAuth-token (sparas inte)" Foreground="{StaticResource MutedTextBrush}" /><PasswordBox x:Name="TokenBox" Background="#10141F" Foreground="White" BorderBrush="#343B50" Padding="11,9" Margin="0,5,0,0" />
                            <TextBlock Text="Utan dessa fungerar chatten anonymt med lokala rollmarkörer." TextWrapping="Wrap" Foreground="#8F8B9E" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock Text="Läsbarhet" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Ändringar syns direkt i overlayen." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" />

                    <DockPanel><TextBlock Text="Textstorlek" /><TextBlock x:Name="FontSizeValue" Text="22 px" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" /></DockPanel>
                    <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,15" ValueChanged="Setting_ValueChanged" />
                    <DockPanel><TextBlock Text="Radavstånd" /><TextBlock x:Name="LineSpacingValue" Text="1,42×" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" /></DockPanel>
                    <Slider x:Name="LineSpacingSlider" Minimum="1.15" Maximum="1.8" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,15" ValueChanged="Setting_ValueChanged" />
                    <DockPanel><TextBlock Text="Bakgrund" /><TextBlock x:Name="OpacityValue" Text="72 %" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" /></DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="0.25" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,17" ValueChanged="Setting_ValueChanged" />

                    <TextBlock Text="Typsnitt" Margin="0,0,0,6" /><ComboBox x:Name="FontFamilyBox" SelectionChanged="Setting_ValueChanged">
                        <ComboBoxItem Content="Verdana" /><ComboBoxItem Content="Segoe UI" /><ComboBoxItem Content="Arial" /><ComboBoxItem Content="Comic Sans MS" />
                    </ComboBox>

                    <Separator Background="#343B50" Margin="0,20" />
                    <CheckBox x:Name="BadgesCheck" Content="Visa badges och rollikoner" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                    <CheckBox x:Name="NameColorsCheck" Content="Använd Twitch-namnfärger" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                    <CheckBox x:Name="TimestampCheck" Content="Visa klockslag" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />
                    <CheckBox x:Name="MentionsCheck" Content="Markera meddelanden till mig" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged" />

                    <TextBlock Text="Antal meddelanden på skärmen" Margin="0,17,0,6" />
                    <ComboBox x:Name="MaxMessagesBox" SelectionChanged="Setting_ValueChanged">
                        <ComboBoxItem Content="10" /><ComboBoxItem Content="14" /><ComboBoxItem Content="18" /><ComboBoxItem Content="24" /><ComboBoxItem Content="30" />
                    </ComboBox>

                    <Border Background="#171F2B" BorderBrush="#293649" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,21,0,0">
                        <StackPanel>
                            <TextBlock Text="Dyslexivänlig grundprofil" Foreground="#78E1D5" FontWeight="SemiBold" />
                            <TextBlock Text="Verdana, 22 px och generöst radavstånd minskar visuell trängsel. Varje chattare får en egen tydligt avskild yta." TextWrapping="Wrap" Foreground="#B8C2CF" Margin="0,6,0,0" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="Tips: lås overlayen när den ligger rätt – då blir den helt klickigenom och stjäl aldrig fokus från spelet." Foreground="#858193" Margin="0,18,0,0" />
    </Grid>
</Window>
