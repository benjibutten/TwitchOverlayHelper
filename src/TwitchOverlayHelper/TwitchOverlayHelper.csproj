<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TwitchOverlayHelper</AssemblyName>
    <Product>Twitch Overlay Helper</Product>
    <Company>BenjiButten</Company>
    <Authors>BenjiButten</Authors>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TwitchOverlayHelper.Tests" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- The dock is served from inside the assembly; the app ships as a single self-contained file. -->
    <EmbeddedResource Include="Web\wwwroot\**\*" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
  </ItemGroup>
</Project>
