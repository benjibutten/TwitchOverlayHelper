<Window x:Class="TwitchOverlayHelper.PetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dina pets" Width="980" Height="860" MinWidth="820" MinHeight="520"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PETS" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="Dina pets" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,6,0,14" LineHeight="20"
                       Text="Varje pet är en mapp i pets-mappen. Här byter du namn, provar animationerna och ser hur peten blir på streamen. Allt sparas i petens egen pet.json, så det följer med mappen." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,14,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Content="Öppna pets-mappen" Background="#343B50" Click="OpenFolder_Click"
                    ToolTip="Alla pets ligger här: en mapp per pet med pet.json och body.svg eller spritesheet.webp." />
            <Button Grid.Column="2" Content="Ladda om pets" Background="#343B50" Click="Reload_Click"
                    ToolTip="Läser in pets-mappen igen – efter att du lagt till en pet eller ändrat en fil för hand." />
            <TextBlock x:Name="StatusText" Grid.Column="4" Text="" Foreground="#F0A85C" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,0">
                <!-- Samma kolumner som raderna nedan, så rubrikerna står över det de beskriver. -->
                <Grid Margin="11,0,11,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="130" /><ColumnDefinition Width="16" /><ColumnDefinition Width="128" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="Pet" Foreground="#8F8B9E" FontSize="11.5" />
                    <TextBlock Grid.Column="4" Text="Sällsynthet" Foreground="#8F8B9E" FontSize="11.5"
                               ToolTip="Styr auran på skärmen och hur ofta peten kommer upp i lyckosnurren." />
                    <TextBlock Grid.Column="6" Text="Lyckosnurren" Foreground="#8F8B9E" FontSize="11.5" />
                    <TextBlock Grid.Column="8" Text="Förhandsvisa" Foreground="#8F8B9E" FontSize="11.5" Width="262" />
                </Grid>

                <ItemsControl x:Name="PetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E2233" BorderBrush="#2C3247" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="130" /><ColumnDefinition Width="16" /><ColumnDefinition Width="128" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                    <Border Width="52" Height="52" Background="#141826" CornerRadius="8">
                                        <Grid>
                                            <!-- Faller tillbaka på emoji när bilden inte går att avkoda. -->
                                            <TextBlock Text="{Binding Emoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding EmojiVisibility}" />
                                            <Image Source="{Binding Portrait}" Stretch="Uniform" Margin="2" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <!-- Namnet som det är: dubbelklick eller pennan öppnar raden för byte. -->
                                        <Grid Visibility="{Binding ReadVisibility}" Background="Transparent"
                                              MouseLeftButtonDown="PetName_DoubleClick"
                                              ToolTip="Dubbelklicka för att byta namn och id.">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#7C7890" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="Id, andra namn tittarna kan skriva, och hur många som vunnit peten." />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✎" Click="PetRename_Click" VerticalAlignment="Center"
                                                    Background="Transparent" Foreground="#7C7890" FontSize="14" Padding="8,4"
                                                    ToolTip="Byt namn och id på peten." />
                                        </Grid>

                                        <Grid Visibility="{Binding EditVisibility}">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                            <TextBox Grid.ColumnSpan="5" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="9,6" KeyDown="PetEdit_KeyDown" IsVisibleChanged="PetEditBox_IsVisibleChanged"
                                                     ToolTip="Namnet som visas – och som tittarna kan skriva i chatten." />
                                            <TextBox Grid.Row="1" Text="{Binding EditId, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" FontSize="12.5" Padding="9,6" Margin="0,5,0,0" KeyDown="PetEdit_KeyDown"
                                                     ToolTip="Petens id: a–z, 0–9, - och _. Vunna pets följer med när det byts." />
                                            <Button Grid.Row="1" Grid.Column="2" Content="✓" Margin="0,5,0,0" Padding="11,6"
                                                    Click="PetEditSave_Click" ToolTip="Spara (Enter)" />
                                            <Button Grid.Row="1" Grid.Column="4" Content="✕" Margin="0,5,0,0" Padding="11,6" Background="#343B50"
                                                    Click="PetEditCancel_Click" ToolTip="Ångra (Esc)" />
                                        </Grid>
                                    </Grid>

                                    <ComboBox Grid.Column="4" VerticalAlignment="Center"
                                              ItemsSource="{Binding Rarities}"
                                              SelectedItem="{Binding Rarity, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="Pet_Changed"
                                              ToolTip="Styr auran på skärmen och hur ofta peten kommer upp i lyckosnurren." />

                                    <CheckBox Grid.Column="6" Content="Bara som vinst" VerticalAlignment="Center"
                                              IsChecked="{Binding IsWinnable, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="Pet_Changed" Unchecked="Pet_Changed"
                                              ToolTip="Peten går bara att få genom lyckosnurren, och bara den som vunnit den kan lösa in den." />

                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🔍 Testvy" Background="#343B50" Padding="12,8" Width="104" Click="PetInspect_Click"
                                                ToolTip="Öppna peten ensam i webbläsaren: prova varje animation, byt bakgrund och se vad appen läser ur spritesheeten." />
                                        <Button Content="▶ Som på streamen" Padding="12,8" Width="150" Margin="8,0,0,0" Click="PetPreview_Click"
                                                ToolTip="Öppna peten ensam på overlayens egen sida, med appens storlek och fart – precis som den ser ut i OBS. Syns inte för tittarna." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Text="Inga pets hittades i pets-mappen." Foreground="#8F8B9E" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="WarningsText" Text="" Foreground="#F0A85C" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Stäng" Background="#343B50" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="20,9" Click="Close_Click" />
    </Grid>
</Window>
