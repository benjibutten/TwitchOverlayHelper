<Window x:Class="TwitchOverlayHelper.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Twitch-chatt-overlay" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Grid>
        <Border x:Name="Surface" CornerRadius="18" BorderThickness="2" Padding="14"
                Background="#B8141720" BorderBrush="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="EditBanner" Visibility="Collapsed" Background="#E96D3FD1" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,10" MouseLeftButtonDown="EditBanner_MouseLeftButtonDown">
                    <DockPanel>
                        <TextBlock Text="✥  DRA LÄNGS DENNA RAD" Foreground="White" FontWeight="Bold" />
                        <TextBlock Text="Redigeringsläge" Foreground="#E9DFFF" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="ChatScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="MessagePanel" VerticalAlignment="Bottom" />
                </ScrollViewer>
            </Grid>
        </Border>
        <primitives:Thumb x:Name="ResizeThumb" Width="26" Height="26" HorizontalAlignment="Right"
                          VerticalAlignment="Bottom" Cursor="SizeNWSE" Visibility="Collapsed"
                          DragDelta="ResizeThumb_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate><Border Background="#F0A970FF" CornerRadius="13" Margin="4"><TextBlock Text="↘" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</Window>
